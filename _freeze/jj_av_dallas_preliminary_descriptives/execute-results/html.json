-align:center;font-weight: bold;\"> Overall </td>\n   <td style=\"text-align:center;font-weight: bold;\"> 7,661 </td>\n   <td style=\"text-align:center;font-weight: bold;\"> 19,953 </td>\n   <td style=\"text-align:center;font-weight: bold;\"> 100.0% </td>\n  </tr>\n</tbody>\n</table>\n\n`````\n:::\n:::\n\n\n\n\n<br>\n\n## Table 2: Unique Youth and Referrals by Race/Ethnicity\n\n\n::: {.cell}\n::: {.cell-output-display}\n`````{=html}\n<table class=\"table table-striped table-hover table-condensed table-responsive\" style=\"margin-left: auto; margin-right: auto;\">\n <thead>\n  <tr>\n   <th style=\"text-align:center;\"> Race/Ethnicity </th>\n   <th style=\"text-align:center;\"> Unique Youth (N) </th>\n   <th style=\"text-align:center;\"> Unique Youth, Percent of Sample (%) </th>\n   <th style=\"text-align:center;\"> Unique Referrals (N) </th>\n   <th style=\"text-align:center;\"> Referrals, Percent of Sample (%) </th>\n  </tr>\n </thead>\n<tbody>\n  <tr>\n   <td style=\"text-align:center;\"> Asian </td>\n   <td style=\"text-align:center;\"> 74 </td>\n   <td style=\"text-align:center;\"> 1.0% </td>\n   <td style=\"text-align:center;\"> 120 </td>\n   <td style=\"text-align:center;\"> 0.6% </td>\n  </tr>\n  <tr>\n   <td style=\"text-align:center;\"> Black </td>\n   <td style=\"text-align:center;\"> 3,379 </td>\n   <td style=\"text-align:center;\"> 44.1% </td>\n   <td style=\"text-align:center;\"> 9,528 </td>\n   <td style=\"text-align:center;\"> 47.8% </td>\n  </tr>\n  <tr>\n   <td style=\"text-align:center;\"> Hispanic </td>\n   <td style=\"text-align:center;\"> 3,443 </td>\n   <td style=\"text-align:center;\"> 44.9% </td>\n   <td style=\"text-align:center;\"> 8,734 </td>\n   <td style=\"text-align:center;\"> 43.8% </td>\n  </tr>\n  <tr>\n   <td style=\"text-align:center;\"> White </td>\n   <td style=\"text-align:center;\"> 757 </td>\n   <td style=\"text-align:center;\"> 9.9% </td>\n   <td style=\"text-align:center;\"> 1,548 </td>\n   <td style=\"text-align:center;\"> 7