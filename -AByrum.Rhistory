### mean and median modifications and extensions
df_modifications_mean_median_year <- df_dallas_county_av_supervision_analytic_file_supervision_episode_technical_de_dup %>%
dplyr::group_by(referral_year) %>%
dplyr::summarise(`Supervision Episodes w/ Technical Violation (N)` = n_distinct(unique_supervision_id),
`Supervision Episodes, with at least one level modification prior to Technical (%)` = scales::percent(n_distinct(unique_supervision_id[modification_increase_prior_to_technical_count_average>0])/`Supervision Episodes w/ Technical Violation (N)`),
`Mean Number of Prior Supervision Level Modifications` = mean(modification_increase_prior_to_technical_count_average,
na.rm = TRUE),
`Median Number of Prior Supervision Level Modifications` = median(modification_increase_prior_to_technical_count_average,
na.rm = TRUE)) %>%
ungroup() %>%
dplyr::rename(`Year of Referral` = referral_year) %>%
mutate(`Year of Referral` = as.character(`Year of Referral`))
