"Moderate Risk") ~ 2,
offense_referral_risk_level=="High Risk" ~ 3,
offense_referral_risk_level=="Unknown" ~ 4,
offense_referral_risk_level=="Not Administered" ~ 5,
TRUE ~ as.numeric(NA)),
### use factor function to assign labels to values
offense_referral_risk_level = factor(offense_referral_risk_level,
levels = c(1,2,3,4,5),
labels =  c("Low Risk",
"Moderate Risk",
"High Risk",
"Unknown",
"Not Administered")),
offense_referral_needs_level =
case_when(
offense_referral_needs_level=="Low Needs" ~ 1,
offense_referral_needs_level=="Moderate Needs" ~ 2,
offense_referral_needs_level=="High Needs" ~ 3,
offense_referral_needs_level=="Unknown" ~ 4,
offense_referral_needs_level=="Not Administered" ~ 5,
TRUE ~ as.numeric(NA)),
### use factor function to assign labels to values
offense_referral_needs_level = factor(offense_referral_needs_level,
levels = c(1,2,3,4,5),
labels = c("Low Needs",
"Moderate Needs",
"High Needs",
"Unknown",
"Not Administered")))
### create denominator -- unique referrals for entire sample
unique_referrals_sample_denom <- n_distinct(df_dallas_county_av_supervision_analytic_file$unique_id,
df_dallas_county_av_supervision_analytic_file$referral_number)
################################################################################
### left join of violations_clean file to supervision_child_join_offenses_5 file
################################################################################
modification_prior_to_technical_violation_count <-
left_join(violations_clean_de_dup,
supervision_level_clean_to_join_modifications_violations,
by = c("unique_id")) %>% ### this is a many to many join so there are now lots of records (all violations joining to all supervisions/supervision extensions/supervision levels)
### now we need to filter on date -- only keeping violation records where the violation_date>=supervision_begin_date & violation_date<=supervision_end_date
### first create fake end date for records where the end date is blank; since this indicates that supervision was ongoing at time of data pull, we still want to include violations that occurred so changing NA to '2030-01-01' in new variable for the following filter
mutate(supervision_end_date_missing_include = ifelse(is.na(supervision_end_date)==TRUE,
ymd(as_date("2030-01-01")),
ymd(as_date(supervision_end_date))),
supervision_end_date_missing_include = ymd(as_date(supervision_end_date_missing_include)),
### flag records with no joining modification information using supervision_level_phase_begin_date
no_modification_records_joined = ifelse(is.na(supervision_level_phase_begin_date==TRUE),
1,0)) %>%
### we only want to keep either (1) violation records with no modifications or (2) supervision records with violation records when those violations occurred during the period of supervision
### we only want records that fit our criteria of:
### violations occurring during the supervision episode
filter(no_modification_records_joined==1 | (violation_date>=supervision_begin_date & violation_date<=supervision_end_date_missing_include)) %>%
### only technical violations
filter(violation_severity_factor=="Technical Violation") %>%
### and modifications occurring before the violation
### and only modifications that were increases in intensiveness
### when we de-dup, we will keep first violation per supervision episode
filter(no_modification_records_joined==1 | (supervision_level_phase_begin_date<violation_date & supervision_level_is_increase_flag==1)) %>%
dplyr::select(unique_id,
violation_referral_number,
referral_number,
unique_supervision_id,
violation,
violation_date,
supervision_begin_date,
supervision_end_date,
supervision_level_phase,
supervision_level_phase_begin_date,
supervision_level_phase_end_date,
supervision_level_is_increase_flag) %>%
distinct() %>%
group_by(unique_supervision_id,
violation_date) %>%
### at this point, we only have records that fit our criteria of
### technical violations occurring during the supervision episode
### modifications occurring before the violation
### and only modifications that were increases in intensiveness
### when we de-dup, we will keep first violation per supervision episode
### now count modifications per violations
mutate(modification_increase_prior_to_technical_count = n_distinct(unique_id,
unique_supervision_id,
supervision_level_phase,
supervision_level_phase_begin_date)) %>%
ungroup() %>%
### for this analysis, keep first violation per supervision episode
### de-dup, keeping first record to preserve violation and linked modifications for supervision period
arrange(unique_supervision_id,
violation_date) %>%
distinct(unique_supervision_id,
.keep_all = TRUE) %>%
dplyr::select(unique_supervision_id,
modification_increase_prior_to_technical_count)
### join lookup table of modification increases occurring prior to first
### technical violation per supervision episode to main analytic file
supervision_child_join_offenses_violatons_7 <- left_join(supervision_child_join_offenses_violatons_6,
modification_prior_to_technical_violation_count,
by = "unique_supervision_id")
### using modification_increase_prior_to_technical_count in this section
### de-dup analytic file by supervision episode since we are calculating mean and medians
### filter on those with at least one technical violation as this will be the base sample
### of the youth with a technical violation, how many experienced increases in supervision level
### intensiveness prior to the violation?
### recode modification var for mean/median; NA needs to be 0
df_dallas_county_av_supervision_analytic_file_supervision_episode_technical_de_dup <- df_dallas_county_av_supervision_analytic_file %>%
distinct(unique_supervision_id,
.keep_all = TRUE) %>%
filter(technical_violation_count>0) %>%
mutate(unique_supervision_extensions_per_supervision_count_average = ifelse(is.na(unique_supervision_extensions_per_supervision_count)==TRUE,
0,unique_supervision_extensions_per_supervision_count),
modification_increase_prior_to_technical_count_average = ifelse(is.na(modification_increase_prior_to_technical_count)==TRUE,
0,modification_increase_prior_to_technical_count))
